__mods["Rng"] = function()
--!strict
-- Deterministic xorshift32 RNG so a given seed always yields the same build.
local Rng = {}
Rng.__index = Rng

function Rng.new(seed)
	seed = (seed or 0) % 4294967296
	if seed == 0 then seed = 0x9E3779B9 end
	return setmetatable({ s = seed }, Rng)
end

function Rng:next() -- returns 32-bit integer
	local s = self.s
	s = bit32.bxor(s, bit32.lshift(s, 13))
	s = bit32.bxor(s, bit32.rshift(s, 17))
	s = bit32.bxor(s, bit32.lshift(s, 5))
	self.s = s
	return s
end

function Rng:float() return self:next() / 4294967296 end

function Rng:int(lo, hi)
	if hi < lo then return lo end
	local span = hi - lo + 1
	return lo + (self:next() % span)
end

function Rng:chance(p) return self:float() < p end

function Rng:pick(list) return list[self:int(1, #list)] end

function Rng:shuffle(list)
	for i = #list, 2, -1 do
		local j = self:int(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

return Rng

end

__mods["Lexer"] = function()
--!strict
-- DeepLuaU Lexer
-- Tokenizes Luau source into a flat token stream for the parser.
-- Handles: identifiers/keywords, all numeric forms (dec/hex/binary, underscores,
-- floats, exponents), short and long strings, long/short comments, every operator
-- and compound-assignment operator, type-annotation punctuation (:, ::), attributes
-- (@native, @checked ...) and backtick interpolated strings.

local Lexer = {}
Lexer.__index = Lexer

local KEYWORDS = {
	["and"] = true, ["break"] = true, ["do"] = true, ["else"] = true,
	["elseif"] = true, ["end"] = true, ["false"] = true, ["for"] = true,
	["function"] = true, ["if"] = true, ["in"] = true, ["local"] = true,
	["nil"] = true, ["not"] = true, ["or"] = true, ["repeat"] = true,
	["return"] = true, ["then"] = true, ["true"] = true, ["until"] = true,
	["while"] = true,
}

local function isDigit(c) return c >= "0" and c <= "9" end
local function isHex(c)
	return (c >= "0" and c <= "9") or (c >= "a" and c <= "f") or (c >= "A" and c <= "F")
end
local function isAlpha(c)
	return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
end
local function isAlphaNum(c)
	return isAlpha(c) or isDigit(c)
end

function Lexer.new(source)
	return setmetatable({
		src = source,
		pos = 1,
		line = 1,
		len = #source,
		tokens = {},
	}, Lexer)
end

function Lexer:error(msg)
	error(("DeepLuaU lex error (line %d): %s"):format(self.line, msg), 0)
end

function Lexer:peek(o)
	local i = self.pos + (o or 0)
	if i > self.len then return "" end
	return self.src:sub(i, i)
end

function Lexer:advance()
	local c = self.src:sub(self.pos, self.pos)
	self.pos += 1
	if c == "\n" then self.line += 1 end
	return c
end

function Lexer:match(s)
	if self.src:sub(self.pos, self.pos + #s - 1) == s then
		for _ = 1, #s do self:advance() end
		return true
	end
	return false
end

-- Reads a long bracket body [[ ]], [=[ ]=], ... returns (content, level) or nil.
function Lexer:tryLongBracket()
	local start = self.pos
	if self:peek() ~= "[" then return nil end
	local p = self.pos + 1
	local level = 0
	while self.src:sub(p, p) == "=" do level += 1; p += 1 end
	if self.src:sub(p, p) ~= "[" then return nil end
	-- consume opening
	self.pos = p + 1
	-- skip a leading newline per Lua spec
	if self:peek() == "\r" then self:advance() end
	if self:peek() == "\n" then self:advance() end
	local close = "]" .. string.rep("=", level) .. "]"
	local idx = self.src:find(close, self.pos, true)
	if not idx then
		self.pos = start
		self:error("unterminated long bracket")
	end
	local content = self.src:sub(self.pos, idx - 1)
	-- advance over content + close, counting newlines
	for _ = self.pos, idx + #close - 1 do self:advance() end
	return content, level
end

function Lexer:readShortString(quote)
	local buf = {}
	self:advance() -- opening quote
	while true do
		local c = self:peek()
		if c == "" or c == "\n" then self:error("unterminated string") end
		if c == quote then self:advance(); break end
		if c == "\\" then
			self:advance()
			local e = self:advance()
			buf[#buf + 1] = "\\" .. e
			-- multi-char escapes (\ddd, \xHH, \u{...}, \z) are preserved verbatim;
			-- subsequent chars handled on next loop iterations.
		else
			buf[#buf + 1] = self:advance()
		end
	end
	return table.concat(buf)
end

-- Backtick interpolated string -> captured raw; parser treats it opaquely.
function Lexer:readInterpString()
	local buf = {}
	self:advance() -- opening backtick
	local depth = 0
	while true do
		local c = self:peek()
		if c == "" then self:error("unterminated interpolated string") end
		if c == "\\" then
			buf[#buf + 1] = self:advance()
			buf[#buf + 1] = self:advance()
		elseif c == "{" then
			depth += 1; buf[#buf + 1] = self:advance()
		elseif c == "}" then
			if depth > 0 then depth -= 1 end
			buf[#buf + 1] = self:advance()
		elseif c == "`" and depth == 0 then
			self:advance(); break
		else
			buf[#buf + 1] = self:advance()
		end
	end
	return table.concat(buf)
end

function Lexer:readNumber()
	local start = self.pos
	if self:peek() == "0" and (self:peek(1) == "x" or self:peek(1) == "X") then
		self:advance(); self:advance()
		while isHex(self:peek()) or self:peek() == "_" do self:advance() end
		-- hex float / binary exponent
		if self:peek() == "." then
			self:advance()
			while isHex(self:peek()) or self:peek() == "_" do self:advance() end
		end
		if self:peek() == "p" or self:peek() == "P" then
			self:advance()
			if self:peek() == "+" or self:peek() == "-" then self:advance() end
			while isDigit(self:peek()) or self:peek() == "_" do self:advance() end
		end
	elseif self:peek() == "0" and (self:peek(1) == "b" or self:peek(1) == "B") then
		self:advance(); self:advance()
		while self:peek() == "0" or self:peek() == "1" or self:peek() == "_" do self:advance() end
	else
		while isDigit(self:peek()) or self:peek() == "_" do self:advance() end
		if self:peek() == "." then
			self:advance()
			while isDigit(self:peek()) or self:peek() == "_" do self:advance() end
		end
		if self:peek() == "e" or self:peek() == "E" then
			self:advance()
			if self:peek() == "+" or self:peek() == "-" then self:advance() end
			while isDigit(self:peek()) or self:peek() == "_" do self:advance() end
		end
	end
	return self.src:sub(start, self.pos - 1)
end

function Lexer:add(type_, value)
	self.tokens[#self.tokens + 1] = { type = type_, value = value, line = self.line }
end

-- Ordered longest-first so multi-char operators win.
local SYMBOLS = {
	"...", "..=", "//=", "::", "->",
	"==", "~=", "<=", ">=", "..", "+=", "-=", "*=", "/=", "%=", "^=", "//",
	"+", "-", "*", "/", "%", "^", "#", "<", ">", "=", "(", ")", "{", "}",
	"[", "]", ";", ":", ",", ".", "?", "&", "|",
}

function Lexer:tokenize()
	while self.pos <= self.len do
		local c = self:peek()

		-- whitespace
		if c == " " or c == "\t" or c == "\r" or c == "\n" then
			self:advance()
		-- comments
		elseif c == "-" and self:peek(1) == "-" then
			self:advance(); self:advance()
			if self:peek() == "[" then
				local content = self:tryLongBracket()
				if content == nil then
					while self:peek() ~= "\n" and self:peek() ~= "" do self:advance() end
				end
			else
				while self:peek() ~= "\n" and self:peek() ~= "" do self:advance() end
			end
		-- long strings
		elseif c == "[" and (self:peek(1) == "[" or self:peek(1) == "=") then
			local content, level = self:tryLongBracket()
			if content ~= nil then
				self:add("String", { kind = "long", value = content, level = level })
			else
				self:advance(); self:add("Symbol", "[")
			end
		-- short strings
		elseif c == '"' or c == "'" then
			local v = self:readShortString(c)
			self:add("String", { kind = "short", value = v, quote = c })
		-- interpolated strings
		elseif c == "`" then
			local v = self:readInterpString()
			self:add("String", { kind = "interp", value = v })
		-- attributes @native @checked ...
		elseif c == "@" then
			self:advance()
			local s = self.pos
			while isAlphaNum(self:peek()) do self:advance() end
			self:add("Attribute", self.src:sub(s, self.pos - 1))
		-- numbers
		elseif isDigit(c) or (c == "." and isDigit(self:peek(1))) then
			self:add("Number", self:readNumber())
		-- identifiers / keywords
		elseif isAlpha(c) then
			local s = self.pos
			while isAlphaNum(self:peek()) do self:advance() end
			local word = self.src:sub(s, self.pos - 1)
			if KEYWORDS[word] then
				self:add("Keyword", word)
			else
				self:add("Name", word)
			end
		else
			-- symbols
			local matched = false
			for _, sym in ipairs(SYMBOLS) do
				if self:match(sym) then
					self:add("Symbol", sym)
					matched = true
					break
				end
			end
			if not matched then
				self:error("unexpected character '" .. c .. "'")
			end
		end
	end
	self:add("EOF", nil)
	return self.tokens
end

return Lexer

end

__mods["Parser"] = function()
--!strict
-- DeepLuaU Parser
-- Recursive-descent parser: tokens -> AST. Parses the full Lua 5.1 grammar plus
-- Luau extensions (compound assignment, continue, if-expressions, type assertions,
-- generics and type annotations). Type annotations and `type`/`export type`
-- statements are PARSED and DROPPED: they carry no runtime meaning in Luau and
-- removing them strips information from the output.

local Lexer = __require("Lexer")

local Parser = {}
Parser.__index = Parser

-- binary operator binding powers {leftBP, rightBP}; right<left => right-assoc
local BINPRI = {
	["or"] = { 1, 1 },
	["and"] = { 2, 2 },
	["<"] = { 3, 3 }, [">"] = { 3, 3 }, ["<="] = { 3, 3 },
	[">="] = { 3, 3 }, ["~="] = { 3, 3 }, ["=="] = { 3, 3 },
	[".."] = { 9, 8 },
	["+"] = { 10, 10 }, ["-"] = { 10, 10 },
	["*"] = { 11, 11 }, ["/"] = { 11, 11 }, ["//"] = { 11, 11 }, ["%"] = { 11, 11 },
	["^"] = { 14, 13 },
}
local UNARY_PRI = 12

local COMPOUND = {
	["+="] = "+", ["-="] = "-", ["*="] = "*", ["/="] = "/",
	["//="] = "//", ["%="] = "%", ["^="] = "^", ["..="] = "..",
}

function Parser.new(source)
	local tokens = Lexer.new(source):tokenize()
	return setmetatable({ tokens = tokens, pos = 1 }, Parser)
end

function Parser:error(msg)
	local t = self.tokens[self.pos]
	error(("DeepLuaU parse error (line %s): %s (got %s %s)"):format(
		tostring(t and t.line), msg, tostring(t and t.type),
		tostring(t and (type(t.value) == "table" and "<str>" or t.value))), 0)
end

function Parser:peek(o) return self.tokens[self.pos + (o or 0)] end
function Parser:next() local t = self.tokens[self.pos]; self.pos += 1; return t end

function Parser:check(type_, value)
	local t = self.tokens[self.pos]
	if not t or t.type ~= type_ then return false end
	if value ~= nil and t.value ~= value then return false end
	return true
end

function Parser:accept(type_, value)
	if self:check(type_, value) then return self:next() end
	return nil
end

function Parser:expect(type_, value)
	local t = self:accept(type_, value)
	if not t then self:error("expected " .. type_ .. (value and (" '" .. value .. "'") or "")) end
	return t
end

function Parser:isKw(w) return self:check("Keyword", w) end
function Parser:isSym(s) return self:check("Symbol", s) end

----------------------------------------------------------------------
-- Type annotations: consumed and discarded.
----------------------------------------------------------------------

function Parser:skipGenericParams()
	-- <T, U, T..., R = Default>
	if not self:isSym("<") then return end
	self:next()
	local depth = 1
	while depth > 0 do
		local t = self:next()
		if not t or t.type == "EOF" then self:error("unterminated generic params") end
		if t.type == "Symbol" and t.value == "<" then depth += 1
		elseif t.type == "Symbol" and t.value == ">" then depth -= 1 end
	end
end

function Parser:skipTypeArgs()
	-- assumes current token is "<"; balance to matching ">"
	self:next()
	local depth = 1
	while depth > 0 do
		local t = self:next()
		if not t or t.type == "EOF" then self:error("unterminated type args") end
		if t.type == "Symbol" and t.value == "<" then depth += 1
		elseif t.type == "Symbol" and t.value == ">" then depth -= 1 end
	end
end

local CLOSE_OF = { ["("] = ")", ["{"] = "}", ["["] = "]" }

function Parser:skipBalanced(open)
	-- current token is `open`; consume through matching close, nesting-aware.
	local close = CLOSE_OF[open]
	self:next()
	local depth = 1
	while depth > 0 do
		local t = self:next()
		if not t or t.type == "EOF" then self:error("unterminated " .. open) end
		if t.type == "Symbol" then
			if t.value == open then depth += 1
			elseif t.value == close then depth -= 1 end
		end
	end
end

function Parser:skipSimpleType()
	if self:isSym("(") then
		self:skipBalanced("(")
	elseif self:isSym("{") then
		self:skipBalanced("{")
	elseif self:isSym("...") then
		self:next(); self:skipSimpleType()
	elseif self:check("String") or self:check("Number") then
		self:next()
	elseif self:check("Name") or self:isKw("nil") or self:isKw("true") or self:isKw("false")
		or self:check("Keyword", "function") then
		self:next()
		while self:isSym(".") do self:next(); self:expect("Name") end
		if self:isSym("<") then self:skipTypeArgs() end
	else
		self:error("expected a type")
	end
	while self:isSym("?") do self:next() end
end

function Parser:skipType()
	self:skipSimpleType()
	while true do
		if self:isSym("|") or self:isSym("&") then
			self:next(); self:skipSimpleType()
		elseif self:isSym("->") then
			self:next(); self:skipSimpleType()
		else
			break
		end
	end
end

----------------------------------------------------------------------
-- Program / blocks
----------------------------------------------------------------------

function Parser:parse()
	local block = self:parseBlock()
	if not self:check("EOF") then self:error("unexpected trailing token") end
	return block
end

local BLOCK_END = {
	["end"] = true, ["else"] = true, ["elseif"] = true, ["until"] = true,
}

function Parser:atBlockEnd()
	if self:check("EOF") then return true end
	local t = self.tokens[self.pos]
	return t.type == "Keyword" and BLOCK_END[t.value] or false
end

function Parser:parseBlock()
	local stats = {}
	while not self:atBlockEnd() do
		if self:isKw("return") then
			stats[#stats + 1] = self:parseReturn()
			break
		end
		local s = self:parseStatement()
		if s then stats[#stats + 1] = s end
	end
	return { kind = "Block", stats = stats }
end

function Parser:parseReturn()
	self:next()
	local exprs = {}
	if not self:atBlockEnd() and not self:isSym(";") then
		exprs = self:parseExprList()
	end
	self:accept("Symbol", ";")
	return { kind = "Return", exprs = exprs }
end

----------------------------------------------------------------------
-- Statements
----------------------------------------------------------------------

function Parser:parseStatement()
	-- stray semicolons
	if self:isSym(";") then self:next(); return nil end

	-- attributes precede function decls: @native function ...
	local attribs = nil
	while self:check("Attribute") do
		attribs = attribs or {}
		attribs[#attribs + 1] = self:next().value
	end

	if self:isKw("local") then return self:parseLocal(attribs) end
	if self:isKw("if") then return self:parseIf() end
	if self:isKw("while") then return self:parseWhile() end
	if self:isKw("for") then return self:parseFor() end
	if self:isKw("repeat") then return self:parseRepeat() end
	if self:isKw("do") then
		self:next()
		local body = self:parseBlock()
		self:expect("Keyword", "end")
		return { kind = "Do", body = body }
	end
	if self:isKw("function") then return self:parseFunctionStat(attribs) end
	if self:isKw("break") then self:next(); return { kind = "Break" } end
	if self:isKw("return") then return self:parseReturn() end

	-- contextual keywords: continue, type, export type
	if self:check("Name", "continue") and not self:isFollowedByCall() then
		self:next(); return { kind = "Continue" }
	end
	if self:check("Name", "type") and self:peek(1) and self:peek(1).type == "Name" then
		return self:parseTypeAlias(false)
	end
	if self:check("Name", "export") and self:peek(1) and self:peek(1).type == "Name"
		and self:peek(1).value == "type" then
		self:next()
		return self:parseTypeAlias(true)
	end

	return self:parseExprStatement()
end

-- distinguishes `continue` statement from a var named continue used in a call/assign
function Parser:isFollowedByCall()
	local n = self:peek(1)
	if not n then return false end
	if n.type == "Symbol" then
		local v = n.value
		return v == "(" or v == "." or v == ":" or v == "[" or v == "="
			or v == "," or v == "{" or COMPOUND[v] ~= nil
	end
	return n.type == "String"
end

function Parser:parseTypeAlias(isExport)
	self:next() -- 'type'
	self:expect("Name")
