function Scope.renameLocals(ast, opts)
	local nameGen = makeNameGen(opts and opts.prefix or nil)
	local r = newResolver(nameGen)
	r:push() -- top-level (chunk) scope; top-level locals are renameable too
	r:blockInline(ast)
	r:pop()
	return ast
end

