	if s:match("^0[bB]") then
		local bits = s:sub(3)
		if bits == "" or bits:match("[^01]") then return nil end
		local v = 0
		for i = 1, #bits do v = v * 2 + (bits:byte(i) - 48) end
		return v
	end
	if s:match("^0[xX]") then
		local v = tonumber(s)
		return v
	end
	if s:match("^%d+$") then
		return tonumber(s)
	end
	return nil
end

local function num(raw)
	return { kind = "Number", raw = raw }
end

-- build an expression tree that evaluates to v (v is a non-negative integer)
local function encode(v, rng, depth)
	-- base cases / termination
	if depth <= 0 or v == 0 then
		if rng:chance(0.5) and v >= 0 and v < 2 ^ 31 then
			return num(string.format("0x%X", v))
		end
		return num(tostring(v))
	end
	local pick = rng:int(1, 3)
	if pick == 1 then
		-- v = a + b
		local a = rng:int(0, v)
		local b = v - a
		return { kind = "Binop", op = "+",
			lhs = encode(a, rng, depth - 1), rhs = encode(b, rng, depth - 1) }
	elseif pick == 2 then
		-- v = c - d, c > v
		local d = rng:int(1, math.max(1, v + 16))
		local c = v + d
		return { kind = "Binop", op = "-",
			lhs = encode(c, rng, depth - 1), rhs = encode(d, rng, depth - 1) }
	else
		-- v = f * g (+ r), using a small factor
		local f = rng:int(2, 9)
		local g = v // f
		local r = v - f * g
		local prod = { kind = "Binop", op = "*",
			lhs = encode(f, rng, depth - 1), rhs = encode(g, rng, depth - 1) }
		if r == 0 then return prod end
		return { kind = "Binop", op = "+", lhs = prod, rhs = encode(r, rng, depth - 1) }
	end
end

-- walk the AST and transform Number nodes in place (wrapped in Paren)
local function walk(node, rng, maxDepth, visited)
	if type(node) ~= "table" then return end
	if visited[node] then return end
	visited[node] = true

	if node.kind == "Number" then
		local v = intValue(node.raw)
		if v and v >= 0 and v < 2 ^ 53 then
			local expr = encode(v, rng, maxDepth)
			if expr.kind ~= "Number" then
				node.kind = "Paren"
				node.expr = expr
				node.raw = nil
			end
		end
		return
	end
	if node.kind == "Raw" then return end -- don't descend into injected source

	for key, child in pairs(node) do
		if type(child) == "table" and key ~= "str" then
			walk(child, rng, maxDepth, visited)
		end
	end
end

function Numbers.run(ast, ctx)
	local depth = (ctx.opts.numberDepth) or 2
	walk(ast, ctx.rng, depth, {})
	return ast
end

Numbers._intValue = intValue
return Numbers

end

__mods["Strings"] = function()
--!strict
-- DeepLuaU string-encryption pass.
-- Every short/long string literal is removed from the source and placed, encrypted,
-- into a single pool that is decrypted ONCE at load time into a local table. Each
-- literal becomes `pool[i]`, i.e. a single table index at runtime -- so there is no
-- per-call / per-frame decryption cost. Interpolated (`backtick`) strings are left
-- untouched because they contain embedded expressions.
--
-- Encryption: per-slot keystream from an xorshift32 state seeded by (seed, slot),
-- XORed byte-by-byte (bit32.bxor). Slots are stored in a shuffled order with an
-- embedded permutation table, so slot numbers in the source reveal nothing.

local Strings = {}

local KMIX = 2654435761 -- Knuth multiplicative constant

local function ks(s)
	s = bit32.bxor(s, bit32.lshift(s, 13))
	s = bit32.bxor(s, bit32.rshift(s, 17))
	s = bit32.bxor(s, bit32.lshift(s, 5))
	return s
end

local function slotSeed(seed, j)
	return ((seed + j * KMIX) % 4294967295) + 1
end

-- build-time: real string value of a literal token
local function realValue(str)
	if str.kind == "long" then
		return str.value
	elseif str.kind == "short" then
		local literal = str.quote .. str.value .. str.quote
		local fn = loadstring("return " .. literal)
		if not fn then return nil end
		local ok, v = pcall(fn)
		if ok and type(v) == "string" then return v end
		return nil
	end
	return nil -- interp
end

local function encryptToLiteral(value, seed, j)
	local s = slotSeed(seed, j)
	local parts = {}
	for i = 1, #value do
		s = ks(s)
		local k = s % 256
		local enc = bit32.bxor(value:byte(i), k)
		parts[i] = "\\" .. enc
	end
	return '"' .. table.concat(parts) .. '"'
end

-- runtime decoder source (self-contained IIFE returning the pool table)
local function buildDecoderSource(dataLiterals, perm, seed)
	local data = "{" .. table.concat(dataLiterals, ",") .. "}"
	local permSrc = "{" .. table.concat(perm, ",") .. "}"
	return ([==[(function()
local d=%s
local p=%s
local SEED=%d
local function ks(s)
s=bit32.bxor(s,bit32.lshift(s,13))
s=bit32.bxor(s,bit32.rshift(s,17))
s=bit32.bxor(s,bit32.lshift(s,5))
return s
end
local pool={}
local bc=string.byte
local ch=string.char
local cc=table.concat
for j=1,#d do
local enc=d[j]
local s=((SEED+j*%d)%%4294967295)+1
local out={}
for i=1,#enc do
s=ks(s)
out[i]=ch(bit32.bxor(bc(enc,i),s%%256))
end
pool[p[j]]=cc(out)
end
return pool
end)()]==]):format(data, permSrc, seed, KMIX)
end

----------------------------------------------------------------------

function Strings.run(ast, ctx)
	local seed = ctx.seed % 4294967296
	local poolName = ctx.poolName -- placeholder local name, renamed later

	local values = {}       -- ordered unique real values
	local indexOf = {}      -- realValue -> index
	local targets = {}      -- list of String nodes to rewrite -> index

	local function collect(node)
		local v = realValue(node.str)
		if v == nil then return nil end
		local idx = indexOf[v]
		if not idx then
			values[#values + 1] = v
			idx = #values
			indexOf[v] = idx
		end
		return idx
	end

	-- walk and rewrite String nodes in place
	local visited = {}
	local function walk(node)
		if type(node) ~= "table" or visited[node] then return end
		visited[node] = true
		if node.kind == "Raw" then return end
		if node.kind == "String" then
			local idx = collect(node)
			if idx then
				node.kind = "Index"
				node.obj = { kind = "Name", name = poolName }
				node.index = { kind = "Number", raw = tostring(idx) }
				node.str = nil
			end
			return
		end
		for key, child in pairs(node) do
			if type(child) == "table" and key ~= "str" then walk(child) end
		end
	end
	for _, s in ipairs(ast.stats) do walk(s) end

	local n = #values
	if n == 0 then
		return ast, nil -- nothing to do
	end

	-- shuffled storage: data[j] encodes values[perm[j]]
	local perm = {}
	for i = 1, n do perm[i] = i end
	ctx.rng:shuffle(perm)

	local dataLiterals = {}
	for j = 1, n do
		local originalIndex = perm[j]
		dataLiterals[j] = encryptToLiteral(values[originalIndex], seed, j)
	end

	local decoder = buildDecoderSource(dataLiterals, perm, seed)
	local prelude = {
		kind = "LocalAssign",
		names = { { name = poolName } },
		exprs = { { kind = "Raw", text = decoder } },
	}
	return ast, prelude
end

Strings._ks = ks
return Strings

end

__mods["Flatten"] = function()
--!strict
-- DeepLuaU control-flow flattening pass (profile "max").
--
-- Converts the linear statement spine of each function body and the chunk into a
-- state-machine dispatch loop:
--
--     local STATE = <start>
--     while STATE ~= 0 do
--         if     STATE == k1 then <stmtA>; STATE = k2
--         elseif STATE == k3 then <stmtB>; STATE = 0
--         elseif STATE == k2 then <stmtC>; STATE = k3
--         ...
--         end
--     end
--
-- State ids are a random permutation and the dispatch branches are shuffled, so the
-- original ordering is destroyed. Top-level `local`s are hoisted to shared slots so
-- their values survive across states. Nested control structures (loops, ifs) are
-- kept intact as opaque units -- so `break`/`continue` keep targeting their real
-- loop -- and nested functions are flattened independently.
--
-- COST: this adds a dispatch loop per flattened function, so it is NOT free. Use the
-- "max" profile on cold / non-hot modules, not on per-frame render code.

local Flatten = {}

local function nameNode(n) return { kind = "Name", name = n } end
local function numNode(v) return { kind = "Number", raw = tostring(v) } end

-- collect every identifier already present so injected names never collide
local function collectNames(root)
	local used = {}
	local seen = {}
	local function walk(node)
		if type(node) ~= "table" or seen[node] then return end
		seen[node] = true
		if node.kind == "Raw" then return end
		if type(node.name) == "string" then used[node.name] = true end
		if type(node.method) == "string" then used[node.method] = true end
		for k, v in pairs(node) do
			if type(v) == "table" then walk(v) end
		end
	end
	walk(root)
	return used
end

-- gather the chunk block plus every function body block
local function collectBlocks(ast)
	local blocks = { ast }
	local seen = {}
	local function walk(node)
		if type(node) ~= "table" or seen[node] then return end
		seen[node] = true
		if node.kind == "Raw" then return end
		if node.kind == "Function" and type(node.body) == "table" then
			blocks[#blocks + 1] = node.body
		end
		for _, v in pairs(node) do
			if type(v) == "table" then walk(v) end
		end
	end
	walk(ast)
	return blocks
end

local function flattenBlock(block, ctx, freshName)
	local stats = block.stats
	if #stats < 3 then return end
	-- bail if a top-level break/continue is present (would retarget the dispatcher)
	for _, s in ipairs(stats) do
		if s.kind == "Break" or s.kind == "Continue" then return end
	end

	local n = #stats
	-- random distinct nonzero state ids
	local ids = {}
	for i = 1, n do ids[i] = i end
	ctx.rng:shuffle(ids)

	local stateVar = freshName()
	local hoist = {}        -- hoisted local names, in order
	local hoistSeen = {}
	local branches = {}     -- { id, body = {stats}, }

	for idx, s in ipairs(stats) do
		local body = {}
		local isReturn = false
		if s.kind == "LocalAssign" then
			for _, nm in ipairs(s.names) do
				if not hoistSeen[nm.name] then
					hoistSeen[nm.name] = true
					hoist[#hoist + 1] = nm.name
				end
			end
			if #s.exprs > 0 then
				local targets = {}
				for _, nm in ipairs(s.names) do targets[#targets + 1] = nameNode(nm.name) end
				body[#body + 1] = { kind = "Assign", targets = targets, exprs = s.exprs }
			end
		elseif s.kind == "LocalFunction" then
			if not hoistSeen[s.name] then
				hoistSeen[s.name] = true
				hoist[#hoist + 1] = s.name
			end
			body[#body + 1] = {
				kind = "Assign",
				targets = { nameNode(s.name) },
				exprs = { s.body },
			}
		elseif s.kind == "Return" then
			isReturn = true
			body[#body + 1] = s
		else
			body[#body + 1] = s
		end

		if not isReturn then
			local nextId = (idx < n) and ids[idx + 1] or 0
			body[#body + 1] = {
				kind = "Assign",
				targets = { nameNode(stateVar) },
				exprs = { numNode(nextId) },
			}
		end
		branches[idx] = { id = ids[idx], body = body }
	end

	-- build shuffled dispatch order
	local order = {}
	for i = 1, n do order[i] = i end
	ctx.rng:shuffle(order)

	local clauses = {}
	for _, idx in ipairs(order) do
		local b = branches[idx]
		clauses[#clauses + 1] = {
			cond = { kind = "Binop", op = "==", lhs = nameNode(stateVar), rhs = numNode(b.id) },
			body = { kind = "Block", stats = b.body },
		}
	end
	local ifStat = { kind = "If", clauses = clauses, elseBody = nil }
	local whileStat = {
		kind = "While",
		cond = { kind = "Binop", op = "~=", lhs = nameNode(stateVar), rhs = numNode(0) },
		body = { kind = "Block", stats = { ifStat } },
	}

	local newStats = {}
	if #hoist > 0 then
		local names = {}
		for _, h in ipairs(hoist) do names[#names + 1] = { name = h } end
		newStats[#newStats + 1] = { kind = "LocalAssign", names = names, exprs = {} }
	end
	newStats[#newStats + 1] = {
		kind = "LocalAssign",
		names = { { name = stateVar } },
		exprs = { numNode(ids[1]) },
	}
	newStats[#newStats + 1] = whileStat
	block.stats = newStats
end

function Flatten.run(ast, ctx)
	local used = collectNames(ast)
	local counter = 0
	local function freshName()
		while true do
			counter += 1
			local candidate = "_DLUf" .. counter
			if not used[candidate] then
				used[candidate] = true
				return candidate
			end
		end
	end

	local blocks = collectBlocks(ast)
	for _, block in ipairs(blocks) do
		flattenBlock(block, ctx, freshName)
	end
	return ast
end

return Flatten

end

__mods["Obfuscator"] = function()
--!strict
-- DeepLuaU Obfuscator -- pipeline orchestrator.
--
-- Profiles (performance vs. resistance trade-off):
--   "none"      parse + minify only (debug/baseline)
--   "light"     + local renaming                         -- zero runtime cost
--   "balanced"  + string encryption + number obfuscation -- near-zero runtime cost
--               (DEFAULT: strings decrypted once at load; numbers fold at compile)
--   "max"       + control-flow flattening + junk          -- resistance over speed
--
-- The honest trade-off: "light"/"balanced" are designed to add no measurable
-- per-frame cost (ideal for game / render loops). "max" adds a dispatch loop and
-- so costs some performance; use it for cold / non-hot modules.

local Parser = __require("Parser")
local Generator = __require("Generator")
local Scope = __require("Scope")
local Rng = __require("Rng")
local Numbers = __require("Numbers")
local Strings = __require("Strings")
local Flatten = __require("Flatten")

local Obfuscator = {}

local PROFILES = {
	none = { rename = false, strings = false, numbers = false, flatten = false },
	light = { rename = true, strings = false, numbers = false, flatten = false },
	balanced = { rename = true, strings = true, numbers = true, flatten = false },
	max = { rename = true, strings = true, numbers = true, flatten = true },
}

function Obfuscator.obfuscate(source, opts)
	opts = opts or {}
	local profileName = opts.profile or "balanced"
	local profile = PROFILES[profileName]
	if not profile then error("DeepLuaU: unknown profile '" .. tostring(profileName) .. "'", 0) end

	local seed = opts.seed or (os.time and os.time()) or 1
	local rng = Rng.new(seed)

	local ast = Parser.new(source):parse()

	local ctx = {
		rng = rng,
		seed = seed,
		opts = opts,
		poolName = "_DLU_pool",
	}

	-- string encryption (produces a prelude that declares the pool local)
	local prelude = nil
	if profile.strings then
		ast, prelude = Strings.run(ast, ctx)
	end

	-- number obfuscation (fold-safe arithmetic)
	if profile.numbers then
		Numbers.run(ast, ctx)
	end

	-- inject the string-pool prelude at the very top, before renaming so the
	-- pool variable and all its references are renamed consistently
	if prelude then
		table.insert(ast.stats, 1, prelude)
	end

	-- local renaming (names resolved & rewritten before flattening)
	if profile.rename then
		Scope.renameLocals(ast, { prefix = opts.namePrefix })
	end

	-- control-flow flattening last: operates on the renamed AST so that all name
	-- resolution is already baked into identifiers and hoisting locals is safe
	if profile.flatten then
		Flatten.run(ast, ctx)
	end

	local out = Generator.generate(ast)

	if opts.header ~= false then
		out = "--[[ Protected with DeepLuaU ]] " .. out
	end
	return out
end

Obfuscator.PROFILES = PROFILES
return Obfuscator

end

return __require("Obfuscator")